# OPTIONAL — this project works with zero environment variables.
#
# js/config.js already contains the Supabase project URL and public
# anon key directly (this is safe — see the comment at the top of
# js/config.js for why). You only need the variables below if you
# want to use scripts/inject-env.js to point a deployment at a
# *different* Supabase project (e.g. a staging environment) without
# editing code.
#
# To use this locally: copy this file to .env and fill in real
# values, then run `node scripts/inject-env.js` before serving the
# site. On Vercel: set these under Project Settings → Environment
# Variables, and the build command in vercel.json runs the same
# script automatically on every deploy.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
