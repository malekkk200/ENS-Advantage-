{
  "name": "ens-advantage-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "ENS Advantage — native Android + iOS + Windows/macOS (Electron) wrappers (Capacitor) with screenshot/screen-recording blocking",
  "scripts": {
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "sync:electron": "cap sync @capawesome/capacitor-electron",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "open:electron": "cap open @capawesome/capacitor-electron",
    "postinstall": "cd electron && npm ci && cd .."
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capawesome/capacitor-electron": "^0.1.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
